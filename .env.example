APP_NAME=Mashroui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://mashroui.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mashroui
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=mashroui.local

SANCTUM_STATEFUL_DOMAINS=mashroui.local:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

FIKRA_API_URL=https://frisbee-pug-zealous.ngrok-free.dev
FIKRA_MODEL=fikra

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد الإلكتروني
# للتطوير: MAIL_MAILER=log (الرسائل تُكتب في storage/logs/laravel.log بدل إرسالها)
# للإنتاج: غيّر MAIL_MAILER=smtp واملأ بيانات مزوّد SMTP بالأسفل
MAIL_MAILER=log
# TLS على المنفذ 587 اترك MAIL_SCHEME=null، أو SSL على 465 اجعلها smtps
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# عنوان المُرسِل الظاهر للمستلم (استخدم بريدًا على نطاقك) واسم المُرسِل
MAIL_FROM_ADDRESS="no-reply@slidd.app"
MAIL_FROM_NAME="مسار"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
